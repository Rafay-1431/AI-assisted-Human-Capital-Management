# ── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC, never commit real value.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider (M8) — any hosted LLM API with tool calling ─────────────────
# AI_PROVIDER is optional: keys starting with "gsk_" auto-select Groq.
# Groq (free tier works): AI_API_KEY=gsk_... AI_MODEL=openai/gpt-oss-120b
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Optional: override the endpoint for any OpenAI-compatible provider
# AI_BASE_URL=https://api.groq.com/openai/v1

# ── Optional first-run bootstrap ─────────────────────────────────────────────
# If set, the /setup wizard pre-fills the Admin account; the wizard also works
# fully from UI input when these are empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
